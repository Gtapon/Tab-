    const textEl = document.getElementById('propText');
    if (textEl) {
      textEl.addEventListener('input', e => {
        p.text = e.target.value;
        clip.name = `テロップ: ${p.text || '無題'}`;
        renderTimeline();
        renderCanvasFrame();
      });
    }
    const colEl = document.getElementById('propColor');
    if (colEl) colEl.addEventListener('input', e => { p.color = e.target.value; renderCanvasFrame(); });
    const strEl = document.getElementById('propStroke');
    if (strEl) strEl.addEventListener('input', e => { p.strokeColor = e.target.value; renderCanvasFrame(); });
