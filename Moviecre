  // --- クリップ編集操作（分割・複製・削除） ---
  function splitSelectedClip() {
    let target = state.clips.find(c => c.id === state.selectedClipId);
    // 選択クリップが再生ヘッド上に無ければ、再生ヘッド上のクリップを自動対象にする
    if (!target || state.currentTime <= target.start + 0.05 || state.currentTime >= target.start + target.duration - 0.05) {
      target = state.clips.find(c => state.currentTime > c.start + 0.05 && state.currentTime < c.start + c.duration - 0.05);
    }
    if (!target) return;

    const splitOffset = state.currentTime - target.start;
    const secondDuration = target.duration - splitOffset;
    target.duration = splitOffset;

    const mediaItem = state.mediaPool.find(m => m.id === target.mediaId);
    const secondClip = {
      ...target,
      id: uid(),
      start: state.currentTime,
      duration: secondDuration,
      offset: target.offset + splitOffset,
      element: mediaItem ? createClipInstanceElement(mediaItem) : null,
      props: { ...target.props }
    };

    state.clips.push(secondClip);
    selectClip(secondClip.id);
    renderTimeline();
    seekTo(state.currentTime);
  }

  function deleteSelectedClip() {
    if (!state.selectedClipId) return;
    const clip = state.clips.find(c => c.id === state.selectedClipId);
    if (clip && clip.element instanceof HTMLMediaElement) {
      clip.element.pause();
    }
    state.clips = state.clips.filter(c => c.id !== state.selectedClipId);
    state.selectedClipId = null;
    renderTimeline();
    renderInspector();
    renderCanvasFrame();
  }

  function duplicateSelectedClip() {
    const clip = state.clips.find(c => c.id === state.selectedClipId);
    if (!clip) return;
    const mediaItem = state.mediaPool.find(m => m.id === clip.mediaId);
    const copy = {
      ...clip,
      id: uid(),
      start: clip.start + clip.duration,
      element: mediaItem ? createClipInstanceElement(mediaItem) : null,
      props: { ...clip.props }
    };
    state.clips.push(copy);
    selectClip(copy.id);
    renderTimeline();
    renderCanvasFrame();
  }

  document.getElementById('btnSplit').addEventListener('click', splitSelectedClip);
  document.getElementById('btnDelete').addEventListener('click', deleteSelectedClip);
  document.getElementById('btnDuplicate').addEventListener('click', duplicateSelectedClip);

  // --- シーク＆再生エンジン ---
  function seekTo(sec) {
    state.currentTime = Math.max(0, sec);
    updatePlayheadUI();

    // 各メディア要素の時刻を同期
    state.clips.forEach(clip => {
      if (clip.element instanceof HTMLMediaElement) {
        const isActive = state.currentTime >= clip.start && state.currentTime < clip.start + clip.duration;
        if (isActive) {
          const targetMediaTime = clip.offset + (state.currentTime - clip.start);
          if (Math.abs(clip.element.currentTime - targetMediaTime) > 0.08) {
            clip.element.currentTime = targetMediaTime;
          }
        } else {
          clip.element.pause();
        }
      }
    });

    renderCanvasFrame();
    // 動画シーク完了後にもう一度再描画してフレームを確実に反映
    setTimeout(renderCanvasFrame, 45);
  }

  function startPlayback() {
    initAudioContext();
    if (state.currentTime >= getTotalDuration()) {
      seekTo(0);
    }
    state.isPlaying = true;
    state.lastFrameTime = performance.now();
    btnPlayPause.textContent = '⏸ 停止';
    statusText.textContent = state.isExporting ? 'レンダリング中...' : '再生中';
    requestAnimationFrame(playbackLoop);
  }

  function pausePlayback() {
    state.isPlaying = false;
    btnPlayPause.textContent = '▶ 再生';
    statusText.textContent = '待機中';
    state.clips.forEach(clip => {
      if (clip.element instanceof HTMLMediaElement) {
        clip.element.pause();
      }
    });
  }

  function playbackLoop(now) {
    if (!state.isPlaying) return;
    const dt = (now - state.lastFrameTime) / 1000;
    state.lastFrameTime = now;
    state.currentTime += dt;

    const totalDur = getTotalDuration();
    if (state.currentTime >= totalDur) {
      state.currentTime = totalDur;
      updatePlayheadUI();
      renderCanvasFrame();
      pausePlayback();
      if (state.isExporting && activeRecorder) {
        activeRecorder.stop();
      }
      return;
    }

    // クリップ内のメディア再生同期
    state.clips.forEach(clip => {
      if (clip.element instanceof HTMLMediaElement) {
        const isActive = state.currentTime >= clip.start && state.currentTime < clip.start + clip.duration;
        const gainNode = connectAudioNode(clip.element);
        if (gainNode) {
          gainNode.gain.value = (clip.props.volume ?? 100) / 100;
        }
        if (isActive) {
          const expectedTime = clip.offset + (state.currentTime - clip.start);
          if (Math.abs(clip.element.currentTime - expectedTime) > 0.25) {
            clip.element.currentTime = expectedTime;
          }
          if (clip.element.paused) {
            clip.element.play().catch(() => {});
          }
        } else if (!clip.element.paused) {
          clip.element.pause();
        }
      }
    });

    updatePlayheadUI();
    renderCanvasFrame();

    if (state.isExporting) {
      const pct = Math.min(100, Math.round((state.currentTime / totalDur) * 100));
      document.getElementById('exportProgressText').textContent = `${pct}% (${formatTimecode(state.currentTime)})`;
    }

    requestAnimationFrame(playbackLoop);
  }

  // --- Canvas合成レンダラー ---
  function renderCanvasFrame() {
    ctx.save();
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // トラック順（V1 -> V2の順で重ね塗り）
    const activeClips = state.clips
      .filter(c => c.track !== 'a1' && state.currentTime >= c.start && state.currentTime < c.start + c.duration)
      .sort((a, b) => (a.track === 'v1' ? -1 : 1));

    activeClips.forEach(clip => {
      const p = clip.props;
      ctx.save();
      ctx.globalAlpha = (p.opacity ?? 100) / 100;

      const scale = (p.scale ?? 100) / 100;
      const centerX = canvas.width / 2 + (p.x || 0);
      const centerY = canvas.height / 2 + (p.y || 0);
      ctx.translate(centerX, centerY);
      ctx.scale(scale, scale);

      if (clip.type === 'video' || clip.type === 'image') {
        ctx.filter = `brightness(${p.brightness}%) contrast(${p.contrast}%) saturate(${p.saturate}%) blur(${p.blur}px)`;
        const el = clip.element;
        if (el) {
          const w = el.videoWidth || el.naturalWidth || canvas.width;
          const h = el.videoHeight || el.naturalHeight || canvas.height;
          // アスペクト比を維持してキャンバス内にフィット
          const ratio = Math.min(canvas.width / w, canvas.height / h);
          const drawW = w * ratio;
          const drawH = h * ratio;
          ctx.drawImage(el, -drawW / 2, -drawH / 2, drawW, drawH);
        }
      } else if (clip.type === 'procedural') {
        ctx.filter = `brightness(${p.brightness}%) contrast(${p.contrast}%) saturate(${p.saturate}%) blur(${p.blur}px)`;
        drawProceduralClip(ctx, clip, state.currentTime - clip.start);
      } else if (clip.type === 'text') {
        ctx.font = `bold ${p.fontSize}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        const metrics = ctx.measureText(p.text);
        const padX = 28;
        const padY = p.fontSize * 0.7;

        if (p.bgBanner) {
          ctx.fillStyle = 'rgba(0, 0, 0, 0.65)';
          ctx.fillRect(-metrics.width / 2 - padX, -padY, metrics.width + padX * 2, padY * 2);
        }
        ctx.lineWidth = Math.max(4, p.fontSize * 0.12);
        ctx.strokeStyle = p.strokeColor || '#000';
        ctx.strokeText(p.text, 0, 0);
        ctx.fillStyle = p.color || '#fff';
        ctx.fillText(p.text, 0, 0);
      }

      ctx.restore();
    });

    ctx.restore();
  }

  // デモ用プロシージャル映像描画
  function drawProceduralClip(ctx, clip, localTime) {
    const w = canvas.width;
    const h = canvas.height;
    ctx.save();
    ctx.translate(-w / 2, -h / 2);

    if (clip.style === 'A') {
      const grad = ctx.createLinearGradient(0, 0, w, h);
      grad.addColorStop(0, '#0f2027');
      grad.addColorStop(0.5, '#203a43');
      grad.addColorStop(1, '#2c5364');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);

      // 回転サークルとカウント
      ctx.strokeStyle = 'rgba(55, 148, 255, 0.5)';
      ctx.lineWidth = 8;
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, 160, 0, Math.PI * 2);
      ctx.stroke();

      ctx.strokeStyle = '#3794ff';
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, 160, -Math.PI / 2, -Math.PI / 2 + (localTime % 1) * Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = '#fff';
      ctx.font = 'bold 110px monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(Math.ceil(clip.duration - localTime), w / 2, h / 2);
    } else {
      ctx.fillStyle = '#1b1429';
      ctx.fillRect(0, 0, w, h);
      ctx.strokeStyle = '#8e44ad';
      ctx.lineWidth = 4;
      ctx.beginPath();
      for (let x = 0; x <= w; x += 20) {
        const y = h / 2 + Math.sin(x * 0.015 + localTime * 5) * 120;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
    ctx.restore();
  }

  // --- トランスポート＆キーボードショートカット ---
  btnPlayPause.addEventListener('click', () => {
    if (state.isPlaying) pausePlayback();
    else startPlayback();
  });
  document.getElementById('btnToStart').addEventListener('click', () => {
    pausePlayback();
    seekTo(0);
  });
  document.getElementById('btnStepBack').addEventListener('click', () => {
    pausePlayback();
    seekTo(state.currentTime - 1 / 30);
  });
  document.getElementById('btnStepFwd').addEventListener('click', () => {
    pausePlayback();
    seekTo(state.currentTime + 1 / 30);
  });

  document.getElementById('canvasRes').addEventListener('change', e => {
    const [w, h] = e.target.value.split('x').map(Number);
    canvas.width = w;
    canvas.height = h;
    renderCanvasFrame();
  });

  window.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
    if (e.code === 'Space') {
      e.preventDefault();
      if (state.isPlaying) pausePlayback();
      else startPlayback();
    } else if (e.code === 'KeyS' || e.code === 'KeyC') {
      splitSelectedClip();
    } else if (e.code === 'Delete' || e.code === 'Backspace') {
      deleteSelectedClip();
    } else if (e.code === 'ArrowLeft') {
      pausePlayback();
      seekTo(state.currentTime - 1 / 30);
    } else if (e.code === 'ArrowRight') {
      pausePlayback();
      seekTo(state.currentTime + 1 / 30);
    }
  });

  // --- ローカル動画書き出し (MediaRecorder) ---
  let activeRecorder = null;

  document.getElementById('btnExport').addEventListener('click', () => {
    if (state.clips.length === 0) {
      alert('タイムラインにクリップがありません。');
      return;
    }
    initAudioContext();
    pausePlayback();
    seekTo(0);

    const canvasStream = canvas.captureStream(30);
    const combinedTracks = [
      ...canvasStream.getVideoTracks(),
      ...(audioDest ? audioDest.stream.getAudioTracks() : [])
    ];
    const combinedStream = new MediaStream(combinedTracks);

    const mimeTypes = [
      'video/webm;codecs=vp9,opus',
      'video/webm;codecs=vp8,opus',
      'video/webm'
    ];
    const mimeType = mimeTypes.find(m => MediaRecorder.isTypeSupported(m)) || '';

    const chunks = [];
    activeRecorder = new MediaRecorder(combinedStream, mimeType ? { mimeType, videoBitsPerSecond: 5000000 } : {});

    activeRecorder.ondataavailable = e => {
      if (e.data && e.data.size > 0) chunks.push(e.data);
    };

    activeRecorder.onstop = () => {
      document.getElementById('exportOverlay').style.display = 'none';
      if (!state.isExporting) return; // キャンセルされた場合
      state.isExporting = false;
      const blob = new Blob(chunks, { type: mimeType || 'video/webm' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `edited_video_${Date.now()}.webm`;
      a.click();
    };

    state.isExporting = true;
    document.getElementById('exportOverlay').style.display = 'flex';
    activeRecorder.start(100);
    startPlayback();
  });

  document.getElementById('btnCancelExport').addEventListener('click', () => {
    state.isExporting = false;
    pausePlayback();
    if (activeRecorder && activeRecorder.state !== 'inactive') {
      activeRecorder.stop();
    }
    document.getElementById('exportOverlay').style.display = 'none';
  });

  // 初期描画
  renderTimeline();
  renderCanvasFrame();
})();
</script>
</body>
</html>
