            <span class="control-val">${p.volume}%</span>
          </div>
        </div>
      `;
    }

    inspectorPanel.innerHTML = html;

    // イベントバインド
    const bindSlider = (id, key, suffix = '') => {
      const el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('input', e => {
        p[key] = Number(e.target.value);
        if (el.nextElementSibling) el.nextElementSibling.textContent = p[key] + suffix;
        renderCanvasFrame();
      });
    };

    bindSlider('propFontSize', 'fontSize');
    bindSlider('propX', 'x');
    bindSlider('propY', 'y');
    bindSlider('propScale', 'scale', '%');
