  // --- タイムライン描画＆ドラッグ操作 ---
  function renderTimeline() {
    const totalSec = Math.max(getTotalDuration() + 10, 20);
    const totalWidth = Math.max(totalSec * state.pxPerSec, timelineScroll.clientWidth);
    timelineWrap.style.width = `${totalWidth}px`;

    // ルーラー描画
    rulerCanvas.width = totalWidth;
    const rCtx = rulerCanvas.getContext('2d');
    rCtx.clearRect(0, 0, totalWidth, 26);
    rCtx.fillStyle = '#969696';
    rCtx.strokeStyle = '#555';
    rCtx.font = '10px monospace';

    const stepSec = state.pxPerSec >= 90 ? 1 : state.pxPerSec >= 40 ? 2 : 5;
    for (let s = 0; s <= totalSec; s += stepSec) {
      const x = Math.floor(s * state.pxPerSec) + 0.5;
      rCtx.beginPath();
      rCtx.moveTo(x, 14);
      rCtx.lineTo(x, 26);
      rCtx.stroke();
      rCtx.fillText(formatTimecode(s).slice(3), x + 4, 12);
    }

    // トラック内のクリップ描画
    document.querySelectorAll('.track-lane').forEach(lane => lane.innerHTML = '');

    state.clips.forEach(clip => {
      const lane = document.querySelector(`.track-lane[data-track="${clip.track}"]`);
      if (!lane) return;

      const el = document.createElement('div');
      el.className = `clip ${clip.track} ${state.selectedClipId === clip.id ? 'selected' : ''}`;
      el.style.left = `${clip.start * state.pxPerSec}px`;
      el.style.width = `${Math.max(clip.duration * state.pxPerSec, 6)}px`;
      el.innerHTML = `
        <div class="clip-handle left"></div>
        <span style="pointer-events:none;overflow:hidden;text-overflow:ellipsis;">${clip.name}</span>
        <div class="clip-handle right"></div>
      `;

      // クリップ選択＆移動ドラッグ
      el.addEventListener('mousedown', e => {
        e.stopPropagation();
        selectClip(clip.id);

        const isLeftHandle = e.target.classList.contains('left');
        const isRightHandle = e.target.classList.contains('right');
        const startX = e.clientX;
        const origStart = clip.start;
        const origDur = clip.duration;
        const origOffset = clip.offset;

        const onMove = moveEvent => {
          const deltaSec = (moveEvent.clientX - startX) / state.pxPerSec;
          if (isLeftHandle) {
            const maxDelta = origDur - 0.2;
            const minDelta = -origOffset;
            const clamped = Math.max(minDelta, Math.min(maxDelta, deltaSec));
            if (origStart + clamped >= 0) {
              clip.start = origStart + clamped;
              clip.offset = origOffset + clamped;
              clip.duration = origDur - clamped;
            }
          } else if (isRightHandle) {
            const maxDur = clip.maxDuration - clip.offset;
            clip.duration = Math.max(0.2, Math.min(maxDur, origDur + deltaSec));
          } else {
            clip.start = Math.max(0, origStart + deltaSec);
          }
          renderTimeline();
          renderCanvasFrame();
        };

        const onUp = () => {
          window.removeEventListener('mousemove', onMove);
          window.removeEventListener('mouseup', onUp);
        };
        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onUp);
      });

      lane.appendChild(el);
    });

    updatePlayheadUI();
    durationDisplay.textContent = `総尺: ${formatTimecode(getTotalDuration()).slice(3)}`;
  }

  function updatePlayheadUI() {
    playheadLine.style.left = `${state.currentTime * state.pxPerSec}px`;
    timecodeDisplay.textContent = formatTimecode(state.currentTime);
  }

  // ルーラークリック・ドラッグでシーク
  let isScrubbing = false;
  rulerCanvas.addEventListener('mousedown', e => {
    isScrubbing = true;
    pausePlayback();
    seekFromMouse(e);
  });
  window.addEventListener('mousemove', e => {
    if (isScrubbing) seekFromMouse(e);
  });
  window.addEventListener('mouseup', () => { isScrubbing = false; });

  function seekFromMouse(e) {
    const rect = rulerCanvas.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const targetSec = Math.max(0, clickX / state.pxPerSec);
    seekTo(targetSec);
  }

  zoomSlider.addEventListener('input', e => {
    state.pxPerSec = Number(e.target.value);
    renderTimeline();
  });

  // --- エフェクトコントロール（インスペクター） ---
  function selectClip(id) {
    state.selectedClipId = id;
    renderTimeline();
    renderInspector();
  }

  function renderInspector() {
